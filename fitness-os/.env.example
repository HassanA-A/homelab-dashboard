# Supabase project (Settings → API). The anon key is safe in the browser; RLS protects data.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# USDA FoodData Central — free key at https://fdc.nal.usda.gov/api-key-signup.html
# Server-only (no NEXT_PUBLIC_ prefix). Falls back to DEMO_KEY, which is heavily rate limited.
USDA_API_KEY=

# Open Food Facts asks API clients to identify themselves.
OFF_USER_AGENT=FitnessOS/0.1 (personal use)
